# Bruno AI Assistant — API Keys
# Copy this file to .env and fill in your keys

# Required: OpenAI API key for Bruno's brain
OPENAI_API_KEY=sk-your-key-here

# Optional: ElevenLabs for premium deep voice (leave empty for free Edge TTS)
ELEVENLABS_API_KEY=

# Optional: Picovoice for "Hey Bruno" wake word (get free at console.picovoice.ai)
# Leave empty to use speech_recognition fallback
PICOVOICE_ACCESS_KEY=

# TTS Settings
TTS_ENGINE=auto  # auto, elevenlabs, edge-tts, macos
ELEVENLABS_VOICE=Adam
EDGE_TTS_VOICE=en-US-AndrewNeural
